<section class="cf-step" data-step="race">
  <h2>{{localize "CHARACTER_FORGE.Step.Race"}}</h2>
  <p class="cf-step-description">{{localize "CHARACTER_FORGE.Race.Desc"}}</p>

  <fieldset class="cf-fieldset">
    <legend>{{localize "CHARACTER_FORGE.Race.Choose"}}</legend>
    <div class="cf-race-grid">
      {{#each races}}
      <button type="button"
              class="cf-race-card{{#if (eq ../raceKey this.key)}} selected{{/if}}{{#if this.isCompendium}} cf-race-card-compendium{{/if}}"
              data-action="select-race"
              data-race="{{this.key}}">
        <div class="cf-race-card-header">
          {{#if this.img}}<img class="cf-race-card-img" src="{{this.img}}" alt="">{{/if}}
          <span class="cf-race-card-name">{{this.displayName}}</span>
        </div>
        {{#if this.asiSummary}}
        <div class="cf-race-card-asi">{{this.asiSummary}}</div>
        {{/if}}
        {{#if this.showMeta}}
        <div class="cf-race-card-meta">
          {{#if this.sizeLabel}}{{this.sizeLabel}}{{/if}}
          {{#if this.speed}} · {{localize "CHARACTER_FORGE.Race.SpeedShort"}} {{this.speed}}{{/if}}
          {{#if this.hasSubraces}}<span class="cf-race-card-subbadge">{{localize "CHARACTER_FORGE.Race.HasSubraces"}}</span>{{/if}}
        </div>
        {{/if}}
        {{#if this.sourceLabel}}
        <div class="cf-race-card-source" title="{{this.sourceLabel}}">{{this.sourceLabel}}</div>
        {{/if}}
      </button>
      {{/each}}
    </div>
  </fieldset>

  {{#if needsSubrace}}
  <fieldset class="cf-fieldset">
    <legend>{{localize "CHARACTER_FORGE.Race.ChooseSubrace"}}</legend>
    <div class="cf-race-grid">
      {{#each selectedRace.subraces}}
      <button type="button"
              class="cf-race-card cf-race-card-sub{{#if (eq ../subraceKey this.key)}} selected{{/if}}"
              data-action="select-subrace"
              data-subrace="{{this.key}}">
        <div class="cf-race-card-header">
          <span class="cf-race-card-name">{{this.displayName}}</span>
        </div>
        <div class="cf-race-card-asi">{{this.asiSummary}}</div>
      </button>
      {{/each}}
    </div>
  </fieldset>
  {{/if}}

  {{#if selectedRace}}
  <fieldset class="cf-fieldset cf-race-preview">
    <legend>
      {{selectedRace.displayName}}
      {{#if selectedRace.sourceLabel}}<span class="cf-imported-badge">{{selectedRace.sourceLabel}}</span>{{/if}}
    </legend>

    {{#unless selectedRace.isCompendium}}
      <p class="cf-race-meta-line">
        <strong>{{localize "CHARACTER_FORGE.Race.SizeLabel"}}:</strong> {{selectedRace.sizeLabel}}
        &middot;
        <strong>{{localize "CHARACTER_FORGE.Race.SpeedLabel"}}:</strong> {{selectedRace.speed}} ft.
      </p>
      <p class="cf-race-meta-line">
        <strong>{{localize "CHARACTER_FORGE.Race.AsiLabel"}}:</strong> {{selectedRace.asiSummary}}
      </p>
      {{#if selectedRace.languagesSummary}}
      <p class="cf-race-meta-line">
        <strong>{{localize "CHARACTER_FORGE.Race.LanguagesLabel"}}:</strong> {{selectedRace.languagesSummary}}
      </p>
      {{/if}}
      {{#if selectedRace.traits.length}}
      <div class="cf-race-traits">
        {{#each selectedRace.traits}}
        <div class="cf-trait">
          <div class="cf-trait-name">{{this.name}}</div>
          <div class="cf-trait-desc">{{this.desc}}</div>
        </div>
        {{/each}}
      </div>
      {{/if}}
    {{else}}
      {{#if selectedRace.descriptionSnippet}}
      <p class="cf-race-snippet">{{selectedRace.descriptionSnippet}}</p>
      {{else}}
      <p class="cf-race-snippet cf-muted">{{localize "CHARACTER_FORGE.Race.CompendiumNoSnippet"}}</p>
      {{/if}}
      <p class="cf-help cf-muted">{{localize "CHARACTER_FORGE.Race.CompendiumNote"}}</p>
    {{/unless}}
  </fieldset>
  {{else}}
  <p class="cf-step-empty">{{localize "CHARACTER_FORGE.Race.SelectPrompt"}}</p>
  {{/if}}
</section>
