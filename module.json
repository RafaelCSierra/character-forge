{
  "id": "character-forge",
  "title": "Character Forge",
  "description": "Friendly wizard for creating and leveling up D&D 5e Player Characters. SRD 5.1/5.2 content included; supports manual JSON imports from 5e.tools. EN + PT-BR.",
  "version": "0.5.0",
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "authors": [
    {
      "name": "Rafael"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "5.2"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/main.mjs"
  ],
  "styles": [
    "styles/cf-wizard.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "pt-BR",
      "name": "Portugues (Brasil)",
      "path": "lang/pt-BR.json"
    }
  ],
  "url": "https://github.com/RafaelCSierra/character-forge",
  "manifest": "https://github.com/RafaelCSierra/character-forge/releases/latest/download/module.json",
  "download": "https://github.com/RafaelCSierra/character-forge/releases/latest/download/module.zip",
  "readme": "https://github.com/RafaelCSierra/character-forge/blob/main/README.md",
  "bugs": "https://github.com/RafaelCSierra/character-forge/issues"
}
